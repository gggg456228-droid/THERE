<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/there_bg"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THERE"
        android:textColor="@color/there_gold"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="22dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сайт выключен"
        android:textColor="@color/there_text"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingBottom="18dp" />

    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:text="Включить сайт"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/openButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:layout_marginTop="10dp"
        android:text="Открыть сайт"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:layout_marginTop="10dp"
        android:text="Выключить сайт"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нажмите &quot;Включить сайт&quot; или &quot;Открыть сайт&quot;"
        android:textColor="@color/there_muted"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingTop="22dp" />

</LinearLayout>
